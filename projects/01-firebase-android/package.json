{
  "name": "firebase-android-template",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.19.0"
  },
  "workspaces": [
    "core/functions",
    "tools"
  ],
  "scripts": {
    "build": "npm --workspace=core-functions run build",
    "typecheck": "npm --workspace=core-functions run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm --workspace=core-functions run test",
    "validate": "npm --workspace=tools-firebase-android run validate",
    "validate:i18n": "npm --workspace=tools-firebase-android run validate:i18n",
    "validate:plugins": "npm --workspace=tools-firebase-android run validate:plugins",
    "validate:security": "npm --workspace=tools-firebase-android run validate:security",
    "agent:sync": "npm --workspace=tools-firebase-android run agent:sync",
    "smoke": "npm --workspace=tools-firebase-android run smoke",
    "tokens:sync": "node ../../shared/design-system/sync-tokens.mjs --android app/android/app/src/main/res",
    "theme": "node ../../shared/design-system/sync-tokens.mjs"
  }
}
