{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tauri Fullstack Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "version",
    "coreMinVersion",
    "permissions",
    "backend",
    "frontend",
    "i18n"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "coreMinVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": {
          "type": "string",
          "pattern": "^backend/[A-Za-z0-9_./-]+\\.js$"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "titleKey"],
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "titleKey": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pt-BR", "en"],
      "properties": {
        "pt-BR": { "type": "string", "pattern": "^locales/pt-BR\\.json$" },
        "en": { "type": "string", "pattern": "^locales/en\\.json$" }
      }
    }
  }
}
