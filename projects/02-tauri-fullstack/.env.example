# Domain used by Caddy in production. Point its DNS A/AAAA record to the VPS first.
APP_DOMAIN=app.example.com
APP_ORIGINS=https://app.example.com,tauri://localhost,http://localhost:1420

# PostgreSQL. Use distinct, long values in the real .env.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://app:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@db:5432/app?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_A_32_BYTE_BASE64_KEY

# Generate unique random secrets; never reuse the example value.
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3000
NODE_ENV=production

# Vite uses a relative same-origin API path by default. For a desktop/mobile app
# targeting an external VPS, set this to e.g. https://app.example.com/api/v1.
VITE_API_BASE_URL=/api/v1
